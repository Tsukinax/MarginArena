# Copy this file to .env and fill in real values. Never commit .env.

# AMD Token Factory: the shared, always-on fallback route (docs/api-guide/tokenfactory-guide.md)
TOKEN_FACTORY_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
TOKEN_FACTORY_API_KEY=rc-...

# Our own vLLM endpoint on the AMD Developer Cloud MI300X (infra/droplet/README.md). The kit fills both:
# `python3 infra/droplet/kit.py prepare` generates VLLM_API_KEY, and `kit.py provision <ip>` writes the URL,
# an sslip.io name made from the droplet's IP (for example https://164-92-10-5.sslip.io/v1).
# `kit.py forget` blanks the URL after the droplet is destroyed, so the app falls back to Token Factory.
VLLM_BASE_URL=
VLLM_API_KEY=

# Evolus event workspace (created via https://app.evolus.ai/join/AMDACT3)
EVOLUS_API_KEY=
EVOLUS_APPLICATION_ID=


# Evolus personal User API Key, needed by infra/evolus/evolus_kit.py to create web services, extractors, memories and skills
EVOLUS_USER_API_KEY=

# Written by `python3 infra/evolus/evolus_kit.py apply` once it has built the workspace. The API reads the workflow ID
# (/api/confirm) and the reader and output-structure IDs (/api/invitation/read); the others identify what apply built.
EVOLUS_LIBRARY_ID=
EVOLUS_AGENT_ID=
EVOLUS_WORKFLOW_ID=
EVOLUS_READER_ID=
EVOLUS_INVITATION_STRUCTURE_ID=

# Signs each Arena result so /api/explain explains only Verdicts this server produced. Optional on one process (a
# random key is made at start); set it when the app runs several processes. Any long random string, e.g.
# `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`.
RESULT_SIGNING_KEY=
