# Copy this file to .env and fill in real values. Never commit .env.

# AMD Token Factory: the shared, always-on fallback route (docs/api-guide/tokenfactory-guide.md)
TOKEN_FACTORY_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
TOKEN_FACTORY_API_KEY=rc-...

# Our own vLLM endpoint on the AMD Developer Cloud MI300X. The droplet bootstrap script prints the URL,
# which uses an sslip.io name made from the droplet's IP (for example https://164-92-10-5.sslip.io/v1).
VLLM_BASE_URL=
VLLM_API_KEY=

# Evolus event workspace (created via https://app.evolus.ai/join/AMDACT3)
EVOLUS_API_KEY=
EVOLUS_APPLICATION_ID=


# Evolus personal User API Key, needed by scripts/evolus_setup.py to create web services, extractors, memories and skills
EVOLUS_USER_API_KEY=
