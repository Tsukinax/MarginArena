# Copy this file to .env and fill in real values. Never commit .env.

# AMD Token Factory: the shared, always-on fallback route (docs/api-guide/tokenfactory-guide.md)
TOKEN_FACTORY_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
TOKEN_FACTORY_API_KEY=rc-...

# Our own vLLM endpoint on the AMD Developer Cloud MI300X (filled in once the droplet is up)
VLLM_BASE_URL=https://<name>.duckdns.org/v1
VLLM_API_KEY=

# Evolus event workspace (created via https://app.evolus.ai/join/AMDACT3)
EVOLUS_API_KEY=
EVOLUS_APPLICATION_ID=

# DuckDNS, used for the droplet's HTTPS hostname
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
